generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, prisma_postgres]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  feedbacks Feedback[]
  themes    Theme[]
  reports   Report[]
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?
  sentiment      String?
  sentimentScore Float?
  status         String          @default("NEW")
  createdAt      DateTime        @default(now())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  themes         FeedbackTheme[]
  embedding      Embedding?
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String?
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  feedbacks   FeedbackTheme[]
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float?

  feedback Feedback @relation(fields: [feedbackId], references: [id])
  theme    Theme    @relation(fields: [themeId], references: [id])

  @@id([feedbackId, themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     Unsupported("vector(384)")
  
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
}

model Report {
  id          String    @id @default(cuid())
  title       String
  periodStart DateTime
  periodEnd   DateTime
  contentJson Json
  generatedBy String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}
